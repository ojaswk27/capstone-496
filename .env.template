# ============================================
# Aerospace Design Assistant - Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys
# At least one LLM API key is required for full functionality

# ===================
# LLM Provider API Keys
# ===================
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Preferred LLM provider: "openai" or "anthropic"
# System will fallback to available provider if preferred is not configured
LLM_PROVIDER=openai

# ===================
# LangSmith Configuration (Optional but Recommended)
# ===================
# LangSmith API key for tracing and debugging
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith project name for organizing traces
LANGSMITH_PROJECT=aerospace-design-assistant

# ===================
# Model Configuration (Optional)
# ===================
# Override default model names if needed
# OPENAI_MODEL=gpt-4-turbo-preview
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ===================
# Workflow Configuration (Optional)
# ===================
# Maximum design iterations before giving up
# MAX_ITERATIONS=3

# Enable verbose output
# VERBOSE=true
